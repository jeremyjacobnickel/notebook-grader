{
  "name": "notebook-grader",
  "displayName": "Notebook Grader",
  "description": "Praktika laden, Tests lokal ausführen und das Ergebnis ans FH-Backend abgeben.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notebookGrader.loadPraktikum",
        "category": "Notebook Grader",
        "title": "Praktikum laden"
      },
      {
        "command": "notebookGrader.runTests",
        "category": "Notebook Grader",
        "title": "Tests ausführen"
      },
      {
        "command": "notebookGrader.submit",
        "category": "Notebook Grader",
        "title": "Ergebnis abgeben"
      },
      {
        "command": "notebookGrader.hint",
        "category": "Notebook Grader",
        "title": "KI-Tipp holen"
      },
      {
        "command": "notebookGrader.showAssignment",
        "category": "Notebook Grader",
        "title": "Aufgabenstellung öffnen"
      },
      {
        "command": "notebookGrader.showOutput",
        "category": "Notebook Grader",
        "title": "Testdetails anzeigen"
      },
      {
        "command": "notebookGrader.testSubtask",
        "category": "Notebook Grader",
        "title": "Teilaufgabe prüfen"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "notebookGrader.scoreView",
          "name": "Notebook Grader"
        }
      ]
    },
    "configuration": {
      "title": "Notebook Grader",
      "properties": {
        "notebookGrader.backendUrl": {
          "type": "string",
          "default": "",
          "description": "Basis-URL des FH-Backends, z. B. https://grader.fh-muenster.de"
        },
        "notebookGrader.courseToken": {
          "type": "string",
          "default": "",
          "description": "Kurs-Token für die Anmeldung am Backend. Wird bei jeder Anfrage mitgeschickt."
        },
        "notebookGrader.tasksSource": {
          "type": "string",
          "default": "",
          "description": "Ordner mit den Praktikums-Aufgaben. Leer = Ordner 'tasks' im geöffneten Workspace. Relative Pfade beziehen sich auf den Workspace."
        },
        "notebookGrader.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python-Interpreter für pytest, z. B. /pfad/zum/projekt/.venv/bin/python."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "publisher": "fh-muenster"
}
