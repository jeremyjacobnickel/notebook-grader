{
  "name": "notebook-grader",
  "displayName": "Notebook Grader",
  "description": "Praktikums-ZIPs laden, Jupyter-Notebooks bearbeiten, Tests lokal ausführen und Ergebnisse ans FH-Backend abgeben.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notebookGrader.loadPraktikum",
        "category": "Notebook Grader",
        "title": "Praktikum laden"
      },
      {
        "command": "notebookGrader.runTests",
        "category": "Notebook Grader",
        "title": "Tests ausführen"
      },
      {
        "command": "notebookGrader.submit",
        "category": "Notebook Grader",
        "title": "Ergebnis abgeben"
      },
      {
        "command": "notebookGrader.hint",
        "category": "Notebook Grader",
        "title": "KI-Tipp holen"
      },
      {
        "command": "notebookGrader.showAssignment",
        "category": "Notebook Grader",
        "title": "Aufgaben-Notebook öffnen"
      },
      {
        "command": "notebookGrader.showOutput",
        "category": "Notebook Grader",
        "title": "Testdetails anzeigen"
      },
      {
        "command": "notebookGrader.testSubtask",
        "category": "Notebook Grader",
        "title": "Teilaufgabe prüfen"
      },
      {
        "command": "notebookGrader.autosaveNow",
        "category": "Notebook Grader",
        "title": "Jetzt sichern",
        "icon": "$(save)"
      },
      {
        "command": "notebookGrader.setGitlabToken",
        "category": "Notebook Grader",
        "title": "GitLab-Token eintragen"
      },
      {
        "command": "notebookGrader.clearGitlabToken",
        "category": "Notebook Grader",
        "title": "GitLab-Token entfernen"
      },
      {
        "command": "notebookGrader.autosaveRefresh",
        "category": "Notebook Grader",
        "title": "Autosave-Verlauf aktualisieren (auch von anderen Geräten)",
        "icon": "$(refresh)"
      },
      {
        "command": "notebookGrader.autosaveOpenSettings",
        "category": "Notebook Grader",
        "title": "Autosave einrichten",
        "icon": "$(gear)"
      },
      {
        "command": "notebookGrader.autosaveShowChanges",
        "category": "Notebook Grader",
        "title": "Änderungen dieses Schritts anzeigen"
      },
      {
        "command": "notebookGrader.autosaveCompareWithCurrent",
        "category": "Notebook Grader",
        "title": "Mit aktuellem Stand vergleichen"
      },
      {
        "command": "notebookGrader.autosaveRestore",
        "category": "Notebook Grader",
        "title": "Diesen Stand wiederherstellen"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "notebookGrader.scoreView",
          "name": "Notebook Grader"
        },
        {
          "id": "notebookGrader.autosaveHistory",
          "name": "Autosave-Verlauf"
        }
      ]
    },
    "configuration": {
      "title": "Notebook Grader",
      "properties": {
        "notebookGrader.backendUrl": {
          "type": "string",
          "default": "",
          "description": "Basis-URL des FH-Backends, z. B. https://grader.fh-muenster.de"
        },
        "notebookGrader.courseToken": {
          "type": "string",
          "default": "",
          "description": "Kurs-Token für die Anmeldung am Backend. Wird bei jeder Anfrage mitgeschickt."
        },
        "notebookGrader.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python-Interpreter für pytest, z. B. /pfad/zum/projekt/.venv/bin/python."
        },
        "notebookGrader.autosave.repositoryUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "HTTPS-URL deines privaten GitLab-Repos für den Autosave, z. B. `https://gitlab.com/name/praktika.git`. Leer = Autosave aus. Das Token gehört nicht hierher, sondern in **Notebook Grader: GitLab-Token eintragen**."
        },
        "notebookGrader.autosave.intervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Abstand der automatischen Sicherungen in Minuten. Gesichert wird nur, wenn sich das Notebook geändert hat."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "notebookGrader.autosaveHistory",
        "when": "!notebookGrader.autosaveConfigured",
        "contents": "Der Autosave ist noch nicht eingerichtet.\n[Autosave einrichten](command:notebookGrader.autosaveOpenSettings)"
      },
      {
        "view": "notebookGrader.autosaveHistory",
        "when": "notebookGrader.autosaveConfigured",
        "contents": "Für dieses Praktikum gibt es noch keine Sicherung. Lade ein Praktikum oder sichere den aktuellen Stand.\n[Jetzt sichern](command:notebookGrader.autosaveNow)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "notebookGrader.autosaveNow",
          "when": "view == notebookGrader.autosaveHistory && notebookGrader.autosaveConfigured",
          "group": "navigation@1"
        },
        {
          "command": "notebookGrader.autosaveRefresh",
          "when": "view == notebookGrader.autosaveHistory",
          "group": "navigation@2"
        },
        {
          "command": "notebookGrader.autosaveOpenSettings",
          "when": "view == notebookGrader.autosaveHistory",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "notebookGrader.autosaveShowChanges",
          "when": "view == notebookGrader.autosaveHistory && viewItem == snapshot",
          "group": "1_compare@1"
        },
        {
          "command": "notebookGrader.autosaveCompareWithCurrent",
          "when": "view == notebookGrader.autosaveHistory && viewItem == snapshot",
          "group": "1_compare@2"
        },
        {
          "command": "notebookGrader.autosaveRestore",
          "when": "view == notebookGrader.autosaveHistory && viewItem == snapshot",
          "group": "2_restore@1"
        }
      ],
      "commandPalette": [
        {
          "command": "notebookGrader.autosaveShowChanges",
          "when": "false"
        },
        {
          "command": "notebookGrader.autosaveCompareWithCurrent",
          "when": "false"
        },
        {
          "command": "notebookGrader.autosaveRestore",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "publisher": "fh-muenster"
}
