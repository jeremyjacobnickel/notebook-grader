# Als .env speichern. Persönliche Schlüssel niemals committen.
LITELLM_BASE_URL=https://litellm.fh-muenster.de/v1
LITELLM_MODEL=default_router
LITELLM_API_KEY=
# Separates lokales Token zwischen Extension und Backend, nicht der LiteLLM-Key.
COURSE_TOKEN=
# Optional: Pfad für die lokale Ergebnisdatenbank.
# SUBMISSIONS_DB=/path/to/submissions.sqlite3
